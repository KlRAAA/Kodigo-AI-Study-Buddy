# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------
# Database: Neon console → your project → Dashboard → Connect →
# "Pooled connection" string (region: AWS Singapore)
DATABASE_URL=

# ---------------------------------------------------------------
# Neon Auth: Neon console → your project → Auth → Configuration.
# NEON_AUTH_BASE_URL looks like https://ep-xxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Any random string of 32+ characters. Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ---------------------------------------------------------------
# Cloudflare Turnstile: dash.cloudflare.com → Turnstile → Add widget.
# For local dev you can use Cloudflare's always-pass test keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------
# AI providers (free tiers), all used through the OpenAI-compatible API
# Google AI Studio → Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq console → API Keys: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter → Keys: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Model chains: comma-separated provider:model, tried in order.
# Checked against each provider's model list on 2026-09-24. See docs/limits.md to change them.
AI_TEXT_CHAIN=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:google/gemma-4-31b-it:free
AI_VISION_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash,openrouter:google/gemma-4-31b-it:free,openrouter:qwen/qwen3.8-27b:free
AI_TIMEOUT_MS=25000
AI_CHUNK_CHARS=12000

# ---------------------------------------------------------------
# Limits (per user per day reset at midnight Asia/Manila)
DAILY_GENERATIONS_PER_USER=20
DAILY_TUTOR_MESSAGES_PER_USER=60
# Shared pool for "explain simpler", "give an example" and quiz generation
DAILY_ASSIST_ACTIONS_PER_USER=15
REQUESTS_PER_MINUTE_PER_USER=5
# Total AI calls per day across all users; new AI calls stop at 90%
GLOBAL_DAILY_AI_BUDGET=900
MAX_INPUT_CHARS=60000
SIGNUPS_PER_IP_PER_HOUR=3

# ---------------------------------------------------------------
# Community
DAILY_SHARES_PER_USER=10
DAILY_REPORTS_PER_USER=20
DAILY_FOLLOWS_PER_USER=100
DAILY_COPIES_PER_USER=30
# Google Cloud console → APIs & Services → Safe Browsing API → Credentials → API key
# (restrict the key to the Safe Browsing API). Free for non-commercial use.
SAFE_BROWSING_API_KEY=

# ---------------------------------------------------------------
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# Public URL of the app (used for the OpenRouter HTTP-Referer header)
NEXT_PUBLIC_APP_URL=http://localhost:3000
